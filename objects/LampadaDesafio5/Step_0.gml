// Dica 1
if (alpha_dica1 < 1)
{
    alpha_dica1 += 0.10;
    if (alpha_dica1 > 1) alpha_dica1 = 1;
}

if (offset_dica1 > 0)
{
    offset_dica1--;
}

// Dica 2
if (alpha_dica2 < 1)
{
    alpha_dica2 += 0.10;
    if (alpha_dica2 > 1) alpha_dica2 = 1;
}

if (offset_dica2 > 0)
{
    offset_dica2--;
}

